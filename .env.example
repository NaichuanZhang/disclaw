# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Anthropic (direct API or proxy)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Or use a proxy:
# ANTHROPIC_BASE_URL=http://your-proxy:4321
# ANTHROPIC_AUTH_TOKEN=sk-1234

# Optional: fallback model (default: anthropic.claude-opus-5-5).
# A /model selection is stored in the DB and takes precedence over this.
# ANTHROPIC_MODEL=anthropic.claude-opus-5-5
# Per-thread model router (interactive sessions; /model router:false turns it off).
# Tiers are model FAMILIES, resolved to the newest matching id in the endpoint's /v1/models catalog.
# ROUTER_FAMILY_CODING=opus
# ROUTER_FAMILY_COMMON=sonnet
# ROUTER_FAMILY_JUDGE=haiku
# Optional exact-id override per tier; ignored (family used) if the catalog doesn't list it.
# ROUTER_MODEL_CODING=
# ROUTER_MODEL_COMMON=
# ROUTER_MODEL_JUDGE=
# ROUTER_BIAS=balanced             # cheap | balanced | strong — tie-break when the judge is unsure or fails

# Gateway Dashboard
GATEWAY_PORT=3000
GATEWAY_TOKEN=your_secret_gateway_token_here
# GATEWAY_PUBLIC_URL=https://your-public-url.com  # Public URL for browser live-view links

# Session
# SESSION_TTL_HOURS=24

# Evolution Engine
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...  # start.sh notifications
# DAYTONA_API_KEY=your_daytona_key                          # Sandbox CI for evolution validation
# DAYTONA_API_URL=https://app.daytona.io/api                # Daytona API endpoint
# EVOLUTION_AUTO_MERGE=true                                 # Auto-merge + deploy PRs once CI passes (default true;
#                                                           # false = require manual evolve_review + evolve_merge)

# Reflection System
# REFLECTION_CHANNEL_ID=your_channel_id_here
# REFLECTION_INTERVAL_HOURS=6
# REFLECTION_LOOKBACK_HOURS=24
# REFLECTION_MIN_SIGNALS=3
# REFLECTION_MODEL=                # Defaults to ANTHROPIC_MODEL

# whisper.cpp local transcription (Discord voice messages)
# WHISPER_CPP_BIN=data/asr/whisper.cpp/build/bin/whisper-cli
# WHISPER_CPP_MODEL=                        # Path to a GGML model. Defaults to
#   data/asr/whisper.cpp/models/ggml-small.bin (multilingual) when present,
#   else data/asr/whisper.cpp/models/ggml-base.en.bin (English-only).
# WHISPER_CPP_LANG=auto                     # whisper-cli -l flag. "auto" lets
#   each utterance be detected independently (needed to mix Chinese, English
#   and French across turns); pin to a code (e.g. "zh", "en", "fr") if auto
#   detection misfires on short clips. Ignored by .en-only models.
# WHISPER_CPP_THREADS=4

# Agentic browser (browser_* tools, live viewer at /browser/:id on the gateway)
# BROWSER_ENABLED=1
# BROWSER_BIN=/path/to/chrome
# BROWSER_MAX=2
# BROWSER_IDLE_MS=600000
# BROWSER_NO_SANDBOX=0
